# ═══════════════════════════════════════════════
#  .gitignore — TikTok Live Studio
#  Node.js + Unity + Media
# ═══════════════════════════════════════════════

# ── Node.js ──────────────────────────────────
node_modules/
npm-debug.log*
.env
.env.local
.env.*.local

# ── Unity (Library, cache, build) ────────────
UnityProject/Library/
UnityProject/Temp/
UnityProject/Logs/
UnityProject/UserSettings/
UnityProject/MemoryCaptures/
UnityProject/obj/
UnityProject/Build/
UnityProject/Builds/
UnityProject/CommercialBuild/
UnityProject/Assets/AssetStoreTools/

# ── Compiled Build output ────────────────────
# Build/ được đưa vào repo để người dùng chạy run.bat là có game ngay.
# Chỉ bỏ qua file log và crash dump do game tạo ra khi chạy.
Build/*.log
Build/**/output_log.txt
Build/**/*.dmp
Build/**/Crashes/

# ── Build logs ───────────────────────────────
build_log.txt

# ── OS & IDE ─────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.csproj.user
*.unityproj
*.sln
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ── Visual Studio / Rider / VSCode ───────────
.vs/
.vscode/
.idea/
*.userprefs

# ── Crash reports ────────────────────────────
sysinfo.txt
crashlytics-build.properties

# Local build, migration backups and diagnostics
.maintenance/
# Data/ được đưa vào repo (asset mẫu + 1 bài nhạc). Chỉ bỏ qua file trạng thái
# do game/bridge tự ghi khi chạy.
Data/Music/MUSIC_COMMAND.json
Data/Music/MUSIC_STATUS.json
Data/Videos/STAGE_STATUS.json
TikTokBridge/*.log
